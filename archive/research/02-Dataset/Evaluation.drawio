        <mxCell id="TpC6bvXpZ9TQo_N7P8WF-37" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Evaluation&lt;/h1&gt;&lt;div&gt;&lt;span style=&quot;text-align: center;&quot;&gt;Instead of having a closed-form conversation (where we would have to predefine the follow-up questions) we create a candidate profile and ask an LLM how to answer based on the score we want to achieve&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="467.5" x="702.5" y="4257.5" as="geometry" />
        </mxCell>
        <mxCell id="TpC6bvXpZ9TQo_N7P8WF-38" edge="1" parent="1" source="TpC6bvXpZ9TQo_N7P8WF-39" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=1 4;endArrow=oval;endFill=1;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1350" y="4573.75" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="TpC6bvXpZ9TQo_N7P8WF-39" parent="1" style="text;whiteSpace=wrap;fillColor=#f5f5f5;fontColor=#333333;strokeColor=none;fontFamily=Courier New;" value="{&#xa;  &quot;_comment&quot;: &quot;Example system run for one scenario using a 1-to-5 scoring scale&quot;,&#xa;  &quot;run_id&quot;: &quot;run_agent_001&quot;,&#xa;  &quot;scenario_id&quot;: &quot;scn_001&quot;,&#xa;  &quot;system_type&quot;: &quot;agentic&quot;,&#xa;  &quot;transcript&quot;: [&#xa;    {&#xa;      &quot;_comment&quot;: &quot;Interviewer asks the candidate to structure the case&quot;,&#xa;      &quot;turn&quot;: 1,&#xa;      &quot;speaker&quot;: &quot;interviewer_agent&quot;,&#xa;      &quot;message&quot;: &quot;How would you structure this market entry problem?&quot;,&#xa;      &quot;stage_id&quot;: &quot;stage_001&quot;,&#xa;      &quot;stage_type&quot;: &quot;case_structure&quot;,&#xa;      &quot;metadata&quot;: {&#xa;        &quot;intent&quot;: &quot;test_case_structure&quot;&#xa;      }&#xa;    },&#xa;    {&#xa;      &quot;_comment&quot;: &quot;Candidate gives a structured answer&quot;,&#xa;      &quot;turn&quot;: 2,&#xa;      &quot;speaker&quot;: &quot;candidate_simulator&quot;,&#xa;      &quot;message&quot;: &quot;I would analyze market attractiveness, competitive landscape, financial impact, and execution risks.&quot;,&#xa;      &quot;stage_id&quot;: &quot;stage_001&quot;,&#xa;      &quot;stage_type&quot;: &quot;case_structure&quot;,&#xa;      &quot;metadata&quot;: {&#xa;        &quot;response_quality&quot;: &quot;strong&quot;&#xa;      }&#xa;    }&#xa;  ],&#xa;  &quot;judge_trace&quot;: [&#xa;    {&#xa;      &quot;_comment&quot;: &quot;Judge evaluation for the case structure stage&quot;,&#xa;      &quot;stage_type&quot;: &quot;case_structure&quot;,&#xa;      &quot;score&quot;: 5,&#xa;      &quot;rationale&quot;: &quot;The candidate used a complete and business-relevant structure.&quot;,&#xa;      &quot;needs_follow_up&quot;: false,&#xa;      &quot;follow_up_question&quot;: null,&#xa;      &quot;knowledge_chunk_ids&quot;: [&quot;chunk_001&quot;, &quot;chunk_002&quot;]&#xa;    }&#xa;  ],&#xa;  &quot;system_feedback&quot;: {&#xa;    &quot;_comment&quot;: &quot;Final system feedback based on the transcript and judge trace&quot;,&#xa;    &quot;scores&quot;: {&#xa;      &quot;case_opening&quot;: &quot;not_tested&quot;,&#xa;      &quot;case_structure&quot;: 5,&#xa;      &quot;case_math_answer&quot;: &quot;not_tested&quot;,&#xa;      &quot;case_creative_answer&quot;: &quot;not_tested&quot;,&#xa;      &quot;final_recommendation&quot;: &quot;not_tested&quot;,&#xa;      &quot;overall&quot;: 5&#xa;    },&#xa;    &quot;feedback_text&quot;: &quot;Your case structure was clear, comprehensive, and aligned with the business problem.&quot;,&#xa;    &quot;strengths&quot;: [&#xa;      &quot;Strong business structure&quot;,&#xa;      &quot;Clear prioritization of key drivers&quot;&#xa;    ],&#xa;    &quot;improvement_areas&quot;: [&#xa;      &quot;Add a brief hypothesis at the beginning&quot;&#xa;    ],&#xa;    &quot;recommended_next_steps&quot;: [&#xa;      &quot;Practice linking each bucket to a measurable business metric&quot;,&#xa;      &quot;Summarize your structure before moving into analysis&quot;&#xa;    ]&#xa;  },&#xa;  &quot;run_metadata&quot;: {&#xa;    &quot;_comment&quot;: &quot;Technical metadata for the run&quot;,&#xa;    &quot;candidate_model&quot;: &quot;gpt-4.1-mini&quot;,&#xa;    &quot;candidate_temperature&quot;: 0.7,&#xa;    &quot;candidate_seed&quot;: 123,&#xa;    &quot;interviewer_backend&quot;: &quot;agentic_interviewer_v1&quot;,&#xa;    &quot;judge_backend&quot;: &quot;mvp_judge_v2&quot;,&#xa;    &quot;prompt_tokens&quot;: 920,&#xa;    &quot;completion_tokens&quot;: 480,&#xa;    &quot;total_tokens&quot;: 1400,&#xa;    &quot;latency_seconds&quot;: 3.8,&#xa;    &quot;stop_reason&quot;: &quot;completed&quot;&#xa;  }&#xa;}" vertex="1">
