        <mxCell id="RDyThFTYfkmwOs9I9s8V-53" parent="1" style="text;whiteSpace=wrap;fillColor=#f5f5f5;fontColor=#333333;strokeColor=none;fontFamily=Courier New;shadow=1;" value="{&#xa;  &quot;structure&quot;: {&#xa;    &quot;description&quot;: &quot;Does the student create a clear framework?&quot;,&#xa;    &quot;score_range&quot;: &quot;1-5&quot;&#xa;  },&#xa;  &quot;business_logic&quot;: {&#xa;    &quot;description&quot;: &quot;Does the student connect the analysis to the business objective?&quot;,&#xa;    &quot;score_range&quot;: &quot;1-5&quot;&#xa;  },&#xa;  &quot;assumptions&quot;: {&#xa;    &quot;description&quot;: &quot;Does the student justify assumptions clearly?&quot;,&#xa;    &quot;score_range&quot;: &quot;1-5&quot;&#xa;  },&#xa;  &quot;quantitative_reasoning&quot;: {&#xa;    &quot;description&quot;: &quot;Does the student handle calculations and estimates logically?&quot;,&#xa;    &quot;score_range&quot;: &quot;1-5&quot;&#xa;  },&#xa;  &quot;communication&quot;: {&#xa;    &quot;description&quot;: &quot;Is the answer clear, concise and interview-like?&quot;,&#xa;    &quot;score_range&quot;: &quot;1-5&quot;&#xa;  }&#xa;}" vertex="1">
