        <mxCell id="RDyThFTYfkmwOs9I9s8V-61" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;shadow=1;" value="Socratic Questions dataset (from paper&amp;nbsp;&lt;p style=&quot;box-sizing: border-box; margin-top: 0px; margin-bottom: 0.5rem; font-weight: 500; line-height: 1.2; caret-color: rgb(33, 37, 41); text-align: start;&quot;&gt;&lt;a href=&quot;https://aclanthology.org/2023.eacl-main.12.pdf&quot; style=&quot;box-sizing: border-box; text-decoration: none;&quot;&gt;&lt;font style=&quot;color: rgb(4, 5, 6);&quot;&gt;Socratic Question Generation: A Novel Dataset, Models, and Evaluation&lt;/font&gt;&lt;/a&gt;)&lt;/p&gt;" vertex="1">
          <mxGeometry height="67.5" width="240" x="1620" y="1751.25" as="geometry" />
        </mxCell>
        <mxCell id="RDyThFTYfkmwOs9I9s8V-62" parent="1" style="text;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;spacingLeft=11;shadow=1;" value="Student&#xa;↓&#xa;Interviewer Agent&#xa;    goal: obtain evidence about the student&#39;s reasoning&#xa;    action: asks follow-up questions&#xa;    tool/data: LoRA-adapted questioning style + case context&#xa;↓&#xa;Shared state / Transcript&#xa;↓&#xa;Judge Agent&#xa;    goal: evaluate whether enough evidence exists&#xa;    action: scores rubric and decides next step&#xa;    tool/data: transcript + rubric + RAG casebook knowledge&#xa;↓&#xa;Decision:&#xa;    if enough evidence → Feedback Agent&#xa;    if not enough evidence → send focus instruction to Interviewer Agent&#xa;↓&#xa;Feedback Agent&#xa;    goal: transform technical evaluation into student-facing coaching&#xa;    action: produces final report" vertex="1">
          <mxGeometry height="330" width="420" x="-320" y="2270" as="geometry" />
        </mxCell>
        <mxCell id="RDyThFTYfkmwOs9I9s8V-63" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" value="&lt;h2 style=&quot;margin-top: 0px;&quot;&gt;Agentic System&lt;/h2&gt;" vertex="1">
