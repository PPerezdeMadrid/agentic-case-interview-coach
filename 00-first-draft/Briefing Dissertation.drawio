        <mxCell id="NEgNs-jiQWyuXZ_AgmjS-39" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Learning and System Evaluation&lt;/h1&gt;&lt;div&gt;To ensure both pedagogical rigour and system reliability, evaluation operates on two intertwined levels: student learning outcomes and the internal behaviour of the agentic system itself. The approach combines human-like assessment (through rubrics and debates) with automated benchmarks for reasoning, coordination, and control.&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="655" x="-75" y="2170" as="geometry" />
        </mxCell>
