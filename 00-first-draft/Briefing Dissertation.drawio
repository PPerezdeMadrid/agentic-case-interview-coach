        </mxCell>
        <mxCell id="NEgNs-jiQWyuXZ_AgmjS-43" parent="1" style="text;whiteSpace=wrap;html=1;strokeColor=default;spacingTop=0;spacingLeft=19;" value="&lt;li data-start=&quot;419&quot; data-end=&quot;468&quot;&gt;&lt;p data-start=&quot;421&quot; data-end=&quot;468&quot;&gt;Strategic diagnosis (Five Forces, value map).&lt;/p&gt;&lt;/li&gt;&lt;li data-start=&quot;472&quot; data-end=&quot;525&quot;&gt;&lt;p data-start=&quot;474&quot; data-end=&quot;525&quot;&gt;Coherence between positioning and cost structure.&lt;/p&gt;&lt;/li&gt;&lt;li data-start=&quot;529&quot; data-end=&quot;580&quot;&gt;&lt;p data-start=&quot;531&quot; data-end=&quot;580&quot;&gt;Negotiation quality (BATNA/anchoring/packages).&lt;/p&gt;&lt;/li&gt;&lt;li data-start=&quot;584&quot; data-end=&quot;635&quot;&gt;&lt;p data-start=&quot;586&quot; data-end=&quot;635&quot;&gt;Financial health (liquidity, margin, &lt;em data-start=&quot;623&quot; data-end=&quot;631&quot;&gt;runway&lt;/em&gt;).&lt;/p&gt;&lt;/li&gt;&lt;li data-start=&quot;639&quot; data-end=&quot;781&quot;&gt;&lt;p data-start=&quot;641&quot; data-end=&quot;781&quot;&gt;Traceability of reasoning (explains the “why”).&lt;/p&gt;&lt;/li&gt;&lt;li data-start=&quot;639&quot; data-end=&quot;781&quot;&gt;&lt;p data-start=&quot;641&quot; data-end=&quot;781&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Supported by &lt;/span&gt;&lt;em style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot; data-start=&quot;709&quot; data-end=&quot;735&quot; data-is-only-node=&quot;&quot;&gt;multi-agent debate/judge&lt;/em&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt; dynamics to strengthen verdict consistency.&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;" vertex="1">
          <mxGeometry height="190" width="470" x="90" y="2280" as="geometry" />
        </mxCell>
