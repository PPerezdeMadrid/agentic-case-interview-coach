{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "synthetic_scenario.schema.json",
  "title": "SyntheticScenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario_id",
    "evaluation_item_id",
    "case_id",
    "candidate_model",
    "candidate_profile",
    "ground_truth"
  ],
  "properties": {
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "evaluation_item_id": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "temperature", "seed"],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "temperature": {
          "type": "number",
          "minimum": 0
        },
        "seed": {
          "type": "integer"
        }
      }
    },
    "candidate_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "performance_level",
        "performance_label",
        "description",
        "behaviour_rules",
        "answer_style"
      ],
      "properties": {
        "performance_level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "performance_label": {
          "type": "string",
          "enum": ["very_weak", "weak", "good", "very_good", "excellent"]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "behaviour_rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "answer_style": {
          "type": "object",
          "additionalProperties": false,
          "required": ["length", "confidence", "clarity", "business_vocabulary"],
          "properties": {
            "length": {
              "type": "string",
              "enum": ["short", "medium", "long"]
            },
            "confidence": {
              "type": "string",
              "enum": ["low", "medium", "high"]
            },
            "clarity": {
              "type": "string",
              "enum": ["low", "medium", "high"]
            },
            "business_vocabulary": {
              "type": "string",
              "enum": ["basic", "professional"]
            }
          }
        }
      }
    },
    "ground_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_scores", "expected_issues", "expected_feedback_points"],
      "properties": {
        "expected_scores": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "case_opening",
            "case_structure",
            "case_math_answer",
            "case_creative_answer",
            "final_recommendation",
            "overall_structure",
            "overall_problem_solving",
            "overall_communication",
            "overall"
          ],
          "properties": {
            "case_opening": { "$ref": "#/$defs/scoreOrNotTested" },
            "case_structure": { "$ref": "#/$defs/scoreOrNotTested" },
            "case_math_answer": { "$ref": "#/$defs/scoreOrNotTested" },
            "case_creative_answer": { "$ref": "#/$defs/scoreOrNotTested" },
            "final_recommendation": { "$ref": "#/$defs/scoreOrNotTested" },
            "overall_structure": { "$ref": "#/$defs/scoreOrNotTested" },
            "overall_problem_solving": { "$ref": "#/$defs/scoreOrNotTested" },
            "overall_communication": { "$ref": "#/$defs/scoreOrNotTested" },
            "overall": { "$ref": "#/$defs/scoreOrNotTested" }
          }
        },
        "expected_issues": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expected_feedback_points": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "scoreOrNotTested": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        {
          "type": "string",
          "enum": ["not_tested"]
        }
      ]
    }
  }
}
