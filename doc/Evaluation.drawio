        <mxCell id="dHADWAc8jQwxs6ERTN_7-7" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;li&gt;&lt;code&gt;trace_id&lt;/code&gt;&lt;/li&gt;&lt;li&gt;&lt;code&gt;run_id&lt;/code&gt;&lt;/li&gt;&lt;li&gt;&lt;code&gt;graph_name&lt;/code&gt;: agentic or baseline&lt;/li&gt;&lt;li&gt;&lt;code&gt;thread_id&lt;/code&gt;&lt;/li&gt;&lt;li&gt;&lt;code&gt;step_index&lt;/code&gt;: sequential step number within the run&lt;/li&gt;&lt;li&gt;&lt;code&gt;node_name&lt;/code&gt;: Interviewer or judge&lt;/li&gt;&lt;li&gt;&lt;code&gt;actor&lt;/code&gt;: actor who executed the action in that step interviewer or judge.&lt;/li&gt;&lt;li&gt;&lt;code&gt;scenario_ref&lt;/code&gt;&lt;/li&gt;&lt;li&gt;&lt;code&gt;turn_index_before&lt;/code&gt;: value of&amp;nbsp;&lt;code&gt;turn_index&lt;/code&gt; before executing the next step&lt;/li&gt;&lt;li&gt;&lt;code&gt;turn_index_after&lt;/code&gt;&lt;/li&gt;&lt;li&gt;&lt;code&gt;judge_round_before&lt;/code&gt;&lt;/li&gt;&lt;li&gt;&lt;code&gt;judge_round_after&lt;/code&gt;&lt;/li&gt;&lt;li&gt;&lt;code&gt;enough_evidence_before&lt;/code&gt;: &lt;code&gt;0&lt;/code&gt; or&amp;nbsp;&amp;nbsp;&lt;code&gt;1&lt;/code&gt;.&lt;/li&gt;&lt;li&gt;&lt;code&gt;enough_evidence_after&lt;/code&gt;&lt;/li&gt;&lt;li&gt;&lt;code&gt;focus_areas_before_json&lt;/code&gt;&lt;/li&gt;&lt;li&gt;&lt;code&gt;focus_areas_after_json&lt;/code&gt;&lt;/li&gt;&lt;li&gt;&lt;code&gt;changed_fields_json&lt;/code&gt;:&amp;nbsp;changes detected between the previous and subsequent states, saved as JSON.&lt;/li&gt;&lt;li&gt;&lt;code&gt;created_at&lt;/code&gt;: Date and time in ISO format of when the trace was saved.&lt;/li&gt;" vertex="1">
          <mxGeometry height="438" width="170" x="610" y="382" as="geometry" />
        </mxCell>
