{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evaluation_scenario_v2.schema.json",
  "title": "EvaluationScenarioV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario_id",
    "evaluation_item_id",
    "case_id",
    "candidate_model",
    "candidate_profile",
    "ground_truth"
  ],
  "properties": {
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "evaluation_item_id": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "temperature", "seed"],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "temperature": {
          "type": "number",
          "minimum": 0
        },
        "seed": {
          "type": "integer"
        }
      }
    },
    "candidate_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "performance_level",
        "performance_label",
        "description",
        "behaviour_rules",
        "answer_style",
        "case_performance_profile",
        "dialogue_quality_profile"
      ],
      "properties": {
        "performance_level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "performance_label": {
          "type": "string",
          "enum": ["very_weak", "weak", "good", "very_good", "excellent"]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "behaviour_rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "answer_style": {
          "type": "object",
          "additionalProperties": false,
          "required": ["length", "confidence", "clarity", "business_vocabulary"],
          "properties": {
            "length": {
              "type": "string",
              "enum": ["short", "medium", "long"]
            },
            "confidence": {
              "type": "string",
              "enum": ["low", "medium", "high"]
            },
            "clarity": {
              "type": "string",
              "enum": ["low", "medium", "high"]
            },
            "business_vocabulary": {
              "type": "string",
              "enum": ["basic", "professional"]
            }
          }
        },
        "case_performance_profile": {
          "$ref": "#/$defs/profileAxis"
        },
        "dialogue_quality_profile": {
          "$ref": "#/$defs/profileAxis"
        }
      }
    },
    "ground_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_scores",
        "expected_issues",
        "expected_feedback_points",
        "case_performance",
        "dialogue_quality"
      ],
      "properties": {
        "expected_scores": {
          "$ref": "#/$defs/rubricScores"
        },
        "expected_issues": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expected_feedback_points": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "case_performance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "strengths",
            "issues",
            "feedback_points",
            "must_hit_insights",
            "must_avoid_errors"
          ],
          "properties": {
            "strengths": { "$ref": "#/$defs/stringList" },
            "issues": { "$ref": "#/$defs/stringList" },
            "feedback_points": { "$ref": "#/$defs/stringList" },
            "must_hit_insights": { "$ref": "#/$defs/stringList" },
            "must_avoid_errors": { "$ref": "#/$defs/stringList" }
          }
        },
        "dialogue_quality": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "expected_scores",
            "strengths",
            "issues",
            "feedback_points"
          ],
          "properties": {
            "expected_scores": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "repetition",
                "concision",
                "responsiveness_to_cues",
                "calibration",
                "unsupported_assumptions",
                "hallucination_control",
                "conversational_flow",
                "listening_and_adaptation"
              ],
              "properties": {
                "repetition": { "$ref": "#/$defs/scoreOnly" },
                "concision": { "$ref": "#/$defs/scoreOnly" },
                "responsiveness_to_cues": { "$ref": "#/$defs/scoreOnly" },
                "calibration": { "$ref": "#/$defs/scoreOnly" },
                "unsupported_assumptions": { "$ref": "#/$defs/scoreOnly" },
                "hallucination_control": { "$ref": "#/$defs/scoreOnly" },
                "conversational_flow": { "$ref": "#/$defs/scoreOnly" },
                "listening_and_adaptation": { "$ref": "#/$defs/scoreOnly" }
              }
            },
            "strengths": { "$ref": "#/$defs/stringList" },
            "issues": { "$ref": "#/$defs/stringList" },
            "feedback_points": { "$ref": "#/$defs/stringList" }
          }
        }
      }
    }
  },
  "$defs": {
    "scoreOrNotTested": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        {
          "type": "string",
          "enum": ["not_tested"]
        }
      ]
    },
    "scoreOnly": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "profileAxis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "label", "traits"],
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "label": {
          "type": "string",
          "enum": ["very_weak", "weak", "good", "very_good", "excellent"]
        },
        "traits": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "rubricScores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_opening",
        "case_structure",
        "case_math_answer",
        "case_creative_answer",
        "final_recommendation",
        "overall_structure",
        "overall_problem_solving",
        "overall_communication",
        "overall"
      ],
      "properties": {
        "case_opening": { "$ref": "#/$defs/scoreOrNotTested" },
        "case_structure": { "$ref": "#/$defs/scoreOrNotTested" },
        "case_math_answer": { "$ref": "#/$defs/scoreOrNotTested" },
        "case_creative_answer": { "$ref": "#/$defs/scoreOrNotTested" },
        "final_recommendation": { "$ref": "#/$defs/scoreOrNotTested" },
        "overall_structure": { "$ref": "#/$defs/scoreOrNotTested" },
        "overall_problem_solving": { "$ref": "#/$defs/scoreOrNotTested" },
        "overall_communication": { "$ref": "#/$defs/scoreOrNotTested" },
        "overall": { "$ref": "#/$defs/scoreOrNotTested" }
      }
    }
  }
}
