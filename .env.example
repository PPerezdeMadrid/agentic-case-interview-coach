# Example of the .env file

LMSTUDIO_BASE_URL=http://localhost:8081/v1
# LMSTUDIO_MODEL=deepseek-r1-distill-llama-8b
LMSTUDIO_MODEL=phi-4
LMSTUDIO_API_KEY=EMPTY
TEMPERATURE=0.5

WORKBENCH_PORT=5020

# LangSmith
LANGSMITH_API_KEY=xxxxxxxxxx
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_TRACING_V2=true

# OpenAI
OPENAI_API_KEY="xxxxxxxxxx"
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com
OPENAI_TEMPERATURE=0

# Open Router
# Final experiment configuration: Interviewer: Llama-3.3 70B | Candidate: Gemma-3 27B | Judge: Qwen2.5 72B | Feedback: Phi-4
OPENROUTER_MODEL_INTERVIEWER = "meta-llama/llama-3.3-70b-instruct"
OPENROUTER_MODEL_CANDIDATE = "google/gemma-3-27b-it"
# Optional alternative candidate model (not wired into the active graph by
# default - see candidate_llm_server_gpt35 in llm_server.py). OpenAI is
# retiring gpt-3.5-turbo-16k on 2026-10-23.
OPENROUTER_MODEL_CANDIDATE_GPT35 = "openai/gpt-3.5-turbo-16k"
OPENROUTER_MODEL_JUDGE = "qwen/qwen-2.5-72b-instruct"
OPENROUTER_MODEL_FEEDBACK = "microsoft/phi-4"
OPENROUTER_API_KEY = "xxxxxxxxxx"
CANDIDATE_TEMPERATURE = 0.8
INTERVIEWER_TEMPERATURE = 0.6
JUDGE_TEMPERATURE = 0.0
FEEDBACK_TEMPERATURE = 0.3

# Turn / round budgets
MAX_INTERVIEWER_TURNS_BEFORE_JUDGE=10
MAX_JUDGE_ROUNDS=7
MAX_BASELINE_TURNS=15
MAX_INTERVIEWER_JSON_RETRIES=3
MAX_BASELINE_JSON_RETRIES=3
