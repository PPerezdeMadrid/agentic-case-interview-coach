# Local workbench
WORKBENCH_PORT=5020

# Optional LangSmith tracing
LANGSMITH_API_KEY=your-langsmith-api-key
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_TRACING_V2=true

# Optional LM Studio / local OpenAI-compatible endpoint
LMSTUDIO_BASE_URL=http://localhost:8081/v1
LMSTUDIO_MODEL=deepseek-r1-distill-llama-8b
LMSTUDIO_API_KEY=lm-studio
LMSTUDIO_TEMPERATURE=0.14
# LMSTUDIO_RUN_LOCAL_TESTS=1

# Optional direct OpenAI endpoint
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.4-nano
OPENAI_BASE_URL=https://api.openai.com
OPENAI_TEMPERATURE=0

# Active runtime: OpenRouter
OPENROUTER_API_KEY=your-openrouter-api-key
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_INTERVIEWER=meta-llama/llama-3.3-70b-instruct
OPENROUTER_MODEL_CANDIDATE=google/gemma-3-27b-it
OPENROUTER_MODEL_JUDGE=qwen/qwen-2.5-72b-instruct
OPENROUTER_MODEL_FEEDBACK=meta-llama/llama-3.3-70b-instruct
OPENROUTER_MODEL_BASELINE=meta-llama/llama-3.3-70b-instruct
CANDIDATE_TEMPERATURE=0.8
INTERVIEWER_TEMPERATURE=0.6
JUDGE_TEMPERATURE=0.0
FEEDBACK_TEMPERATURE=0.3
BASELINE_TEMPERATURE=0.0
CANDIDATE_MAX_TOKENS=1024

# Turn / round budgets
MAX_INTERVIEWER_TURNS_BEFORE_JUDGE=10
MAX_INTERVIEWER_TURNS_TOTAL=15
MAX_JUDGE_ROUNDS=7
MAX_BASELINE_TURNS=15
MAX_INTERVIEWER_JSON_RETRIES=3
MAX_BASELINE_JSON_RETRIES=3
