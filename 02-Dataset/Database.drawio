        <mxCell id="kh5bWiEy8WdyAaxlAQ-b-96" parent="1" style="text;whiteSpace=wrap;fontFamily=Courier New;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;fontStyle=0" value="{&#xa;  &quot;rubric_name&quot;: &quot;Consulting Case Interview Rubric&quot;,&#xa;  &quot;source&quot;: &quot;https://assets.managementconsulted.com/app/uploads/2025/06/02180347/Management-Consulted-Case-Interview-Scoring-Guide-2025.pdf?utm_campaign=Partner+CS%3A+app+deadlines+for+UG%2FMS+V2+-+2025.06.2&amp;utm_medium=ghl&quot;,&#xa;  &quot;score_scale&quot;: {&#xa;    &quot;1&quot;: &quot;Needs improvement&quot;,&#xa;    &quot;2&quot;: &quot;Developing&quot;,&#xa;    &quot;3&quot;: &quot;Average&quot;,&#xa;    &quot;4&quot;: &quot;Excellent&quot;,&#xa;    &quot;not_tested&quot;: &quot;Insufficient evidence or section not covered&quot;&#xa;  },&#xa;  &quot;rubric_sections&quot;: {&#xa;    &quot;case_opening&quot;: {&#xa;      &quot;purpose&quot;: &quot;Evaluates how the candidate recaps the prompt, asks clarifying questions, and frames the business problem.&quot;,&#xa;      &quot;used_for&quot;: [&quot;atomic_response_dataset&quot;, &quot;synthetic_conversation_dataset&quot;]&#xa;    },&#xa;    &quot;case_structure&quot;: {&#xa;      &quot;purpose&quot;: &quot;Evaluates whether the candidate builds a clear, MECE, case-specific and prioritized framework.&quot;,&#xa;      &quot;used_for&quot;: [&quot;atomic_response_dataset&quot;, &quot;synthetic_conversation_dataset&quot;]&#xa;    },&#xa;    &quot;case_math_answer&quot;: {&#xa;      &quot;purpose&quot;: &quot;Evaluates quantitative setup, calculation accuracy, explanation, and ability to convert numbers into business insights.&quot;,&#xa;      &quot;used_for&quot;: [&quot;atomic_response_dataset&quot;, &quot;synthetic_conversation_dataset&quot;]&#xa;    },&#xa;    &quot;case_creative_answer&quot;: {&#xa;      &quot;purpose&quot;: &quot;Evaluates brainstorming quality, structure, creativity, rationale, and ability to generate additional ideas.&quot;,&#xa;      &quot;used_for&quot;: [&quot;atomic_response_dataset&quot;, &quot;synthetic_conversation_dataset&quot;]&#xa;    },&#xa;    &quot;final_recommendation&quot;: {&#xa;      &quot;purpose&quot;: &quot;Evaluates whether the candidate gives a clear recommendation supported by case evidence, risks, and next steps.&quot;,&#xa;      &quot;used_for&quot;: [&quot;atomic_response_dataset&quot;, &quot;synthetic_conversation_dataset&quot;]&#xa;    },&#xa;    &quot;overall_structure&quot;: {&#xa;      &quot;purpose&quot;: &quot;Evaluates how well the candidate leads the whole case, organizes ideas, prioritizes, and connects different parts of the case.&quot;,&#xa;      &quot;used_for&quot;: [&quot;synthetic_conversation_dataset&quot;]&#xa;    },&#xa;    &quot;overall_problem_solving&quot;: {&#xa;      &quot;purpose&quot;: &quot;Evaluates whether the candidate stays focused on the business objective, uses evidence, and drives toward a solution across the full interview.&quot;,&#xa;      &quot;used_for&quot;: [&quot;synthetic_conversation_dataset&quot;]&#xa;    },&#xa;    &quot;overall_communication&quot;: {&#xa;      &quot;purpose&quot;: &quot;Evaluates clarity, confidence, concision, executive presence, and interview-style communication across the full case.&quot;,&#xa;      &quot;used_for&quot;: [&quot;synthetic_conversation_dataset&quot;]&#xa;    }&#xa;  }&#xa;}" vertex="1">
          <mxGeometry height="790" width="830" x="-1700" y="3075" as="geometry" />
        </mxCell>
