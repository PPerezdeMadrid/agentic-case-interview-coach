        <mxCell id="RDyThFTYfkmwOs9I9s8V-52" parent="1" style="text;whiteSpace=wrap;fillColor=#f5f5f5;fontColor=#333333;strokeColor=none;fontFamily=Courier New;shadow=1;" value="[&#xa;  {&#xa;    &quot;speaker&quot;: &quot;interviewer&quot;,&#xa;    &quot;turn&quot;: 1,&#xa;    &quot;text&quot;: &quot;How would you approach this case?&quot;&#xa;  },&#xa;  {&#xa;    &quot;speaker&quot;: &quot;student&quot;,&#xa;    &quot;turn&quot;: 2,&#xa;    &quot;text&quot;: &quot;I would look at market size, competitors and costs.&quot;&#xa;  }&#xa;]" vertex="1">
          <mxGeometry height="195" width="500" x="-630" y="1912.5" as="geometry" />
        </mxCell>
        <mxCell id="RDyThFTYfkmwOs9I9s8V-53" parent="1" style="text;whiteSpace=wrap;fillColor=#f5f5f5;fontColor=#333333;strokeColor=none;fontFamily=Courier New;shadow=1;" value="{&#xa;  &quot;structure&quot;: {&#xa;    &quot;description&quot;: &quot;Does the student create a clear framework?&quot;,&#xa;    &quot;score_range&quot;: &quot;1-5&quot;&#xa;  },&#xa;  &quot;business_logic&quot;: {&#xa;    &quot;description&quot;: &quot;Does the student connect the analysis to the business objective?&quot;,&#xa;    &quot;score_range&quot;: &quot;1-5&quot;&#xa;  },&#xa;  &quot;assumptions&quot;: {&#xa;    &quot;description&quot;: &quot;Does the student justify assumptions clearly?&quot;,&#xa;    &quot;score_range&quot;: &quot;1-5&quot;&#xa;  },&#xa;  &quot;quantitative_reasoning&quot;: {&#xa;    &quot;description&quot;: &quot;Does the student handle calculations and estimates logically?&quot;,&#xa;    &quot;score_range&quot;: &quot;1-5&quot;&#xa;  },&#xa;  &quot;communication&quot;: {&#xa;    &quot;description&quot;: &quot;Is the answer clear, concise and interview-like?&quot;,&#xa;    &quot;score_range&quot;: &quot;1-5&quot;&#xa;  }&#xa;}" vertex="1">
          <mxGeometry height="325" width="820" x="1530" y="1965" as="geometry" />
        </mxCell>
        <mxCell id="RDyThFTYfkmwOs9I9s8V-54" parent="1" style="shape=card;whiteSpace=wrap;html=1;size=20;fillColor=#dae8fc;strokeColor=#6c8ebf;shadow=1;" value="" vertex="1">
          <mxGeometry height="50" width="60" x="640" y="2280" as="geometry" />
        </mxCell>
        <mxCell id="RDyThFTYfkmwOs9I9s8V-55" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontStyle=1;fontColor=#007FFF;shadow=1;" value="Prompt Template" vertex="1">
          <mxGeometry height="30" width="110" x="620" y="2250" as="geometry" />
        </mxCell>
        <mxCell id="RDyThFTYfkmwOs9I9s8V-56" parent="1" style="text;whiteSpace=wrap;fillColor=#f5f5f5;fontColor=#333333;strokeColor=none;fontFamily=Courier New;shadow=1;" value="{&#xa;  &quot;evidence_sufficiency&quot;: &quot;insufficient&quot;,&#xa;  &quot;missing_evidence&quot;: [&#xa;    &quot;No evidence of quantitative reasoning&quot;,&#xa;    &quot;No evidence of assumptions justification&quot;&#xa;  ],&#xa;  &quot;recommended_next_focus&quot;: &quot;Ask a follow-up question about assumptions behind market sizing.&quot;&#xa;}" vertex="1">
          <mxGeometry height="140" width="740" x="920" y="2360" as="geometry" />
        </mxCell>
        <mxCell id="RDyThFTYfkmwOs9I9s8V-57" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;shadow=1;" value="An example of Judge&#39;s output:" vertex="1">
          <mxGeometry height="30" width="170" x="920" y="2540" as="geometry" />
        </mxCell>
        <mxCell id="RDyThFTYfkmwOs9I9s8V-58" parent="1" style="text;whiteSpace=wrap;fontFamily=Courier New;fillColor=#f5f5f5;fontColor=#333333;strokeColor=none;shadow=1;" value="{&#xa;  &quot;overall_score&quot;: 3,&#xa;  &quot;dimension_scores&quot;: {&#xa;    &quot;structure&quot;: 4,&#xa;    &quot;business_logic&quot;: 3,&#xa;    &quot;assumptions&quot;: 2,&#xa;    &quot;quantitative_reasoning&quot;: 2,&#xa;    &quot;communication&quot;: 4&#xa;  },&#xa;  &quot;strengths&quot;: [&#xa;    &quot;The student used a basic revenue/cost structure.&quot;&#xa;  ],&#xa;  &quot;weaknesses&quot;: [&#xa;    &quot;The student did not justify assumptions.&quot;&#xa;  ],&#xa;  &quot;evidence&quot;: [&#xa;    {&#xa;      &quot;dimension&quot;: &quot;structure&quot;,&#xa;      &quot;quote&quot;: &quot;I would look at market size, competitors and costs.&quot;,&#xa;      &quot;interpretation&quot;: &quot;Shows an initial framework, but not deeply developed.&quot;&#xa;    }&#xa;  ],&#xa;  &quot;evidence_sufficiency&quot;: &quot;insufficient&quot;,&#xa;  &quot;recommended_next_focus&quot;: &quot;Ask the student to justify their assumptions.&quot;&#xa;}" vertex="1">
          <mxGeometry height="380" width="640" x="920" y="2580" as="geometry" />
        </mxCell>
        <mxCell id="RDyThFTYfkmwOs9I9s8V-59" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;shadow=1;" value="Adapt socratic questions to consulting cases with an LLM and train with few-example-shot prompt engineer technique" vertex="1">
          <mxGeometry height="30" width="210" x="1440" y="1877.5" as="geometry" />
        </mxCell>
        <mxCell id="RDyThFTYfkmwOs9I9s8V-60" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;shadow=1;" value="Small fine-tuning with socratic questions" vertex="1">
          <mxGeometry height="30" width="120" x="1460" y="1767.5" as="geometry" />
        </mxCell>
        <mxCell id="RDyThFTYfkmwOs9I9s8V-61" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;shadow=1;" value="Socratic Questions dataset (from paper&amp;nbsp;&lt;p style=&quot;box-sizing: border-box; margin-top: 0px; margin-bottom: 0.5rem; font-weight: 500; line-height: 1.2; caret-color: rgb(33, 37, 41); text-align: start;&quot;&gt;&lt;a href=&quot;https://aclanthology.org/2023.eacl-main.12.pdf&quot; style=&quot;box-sizing: border-box; text-decoration: none;&quot;&gt;&lt;font style=&quot;color: rgb(4, 5, 6);&quot;&gt;Socratic Question Generation: A Novel Dataset, Models, and Evaluation&lt;/font&gt;&lt;/a&gt;)&lt;/p&gt;" vertex="1">
          <mxGeometry height="67.5" width="240" x="1620" y="1751.25" as="geometry" />
        </mxCell>
        <mxCell id="RDyThFTYfkmwOs9I9s8V-62" parent="1" style="text;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;spacingLeft=11;shadow=1;" value="Student&#xa;↓&#xa;Interviewer Agent&#xa;    goal: obtain evidence about the student&#39;s reasoning&#xa;    action: asks follow-up questions&#xa;    tool/data: LoRA-adapted questioning style + case context&#xa;↓&#xa;Shared state / Transcript&#xa;↓&#xa;Judge Agent&#xa;    goal: evaluate whether enough evidence exists&#xa;    action: scores rubric and decides next step&#xa;    tool/data: transcript + rubric + RAG casebook knowledge&#xa;↓&#xa;Decision:&#xa;    if enough evidence → Feedback Agent&#xa;    if not enough evidence → send focus instruction to Interviewer Agent&#xa;↓&#xa;Feedback Agent&#xa;    goal: transform technical evaluation into student-facing coaching&#xa;    action: produces final report" vertex="1">
          <mxGeometry height="330" width="420" x="-320" y="2270" as="geometry" />
        </mxCell>
        <mxCell id="RDyThFTYfkmwOs9I9s8V-63" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" value="&lt;h2 style=&quot;margin-top: 0px;&quot;&gt;Agentic System&lt;/h2&gt;" vertex="1">
          <mxGeometry height="50" width="260" x="-320" y="2220" as="geometry" />
        </mxCell>
        <mxCell id="RDyThFTYfkmwOs9I9s8V-65" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;p&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;span data-start=&quot;1116&quot; data-end=&quot;1145&quot; style=&quot;caret-color: rgb(0, 0, 0); color: rgb(0, 0, 0); font-style: normal; font-variant-caps: normal; letter-spacing: normal; text-align: start; text-indent: 0px; text-transform: none; white-space: normal; word-spacing: 0px; -webkit-text-stroke-width: 0px; text-decoration: none;&quot;&gt;Shared state / transcript --&amp;gt; Paper:&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;caret-color: rgb(0, 0, 0);&quot;&gt;Generative Agents — Interactive Simulacra of Human Behavior&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;span style=&quot;caret-color: rgb(0, 0, 0);&quot;&gt;Role-Playing --&amp;gt; Paper: CAMEL&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;/p&gt;&lt;p&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;span style=&quot;caret-color: rgb(0, 0, 0);&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="290" x="-630" y="2350" as="geometry" />
        </mxCell>
        <mxCell id="RDyThFTYfkmwOs9I9s8V-68" edge="1" parent="1" source="RDyThFTYfkmwOs9I9s8V-66" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="RDyThFTYfkmwOs9I9s8V-67">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="RDyThFTYfkmwOs9I9s8V-66" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;" value="https://assets.managementconsulted.com/app/uploads/2025/06/02180347/Management-Consulted-Case-Interview-Scoring-Guide-2025.pdf?utm_campaign=Partner+CS%3A+app+deadlines+for+UG%2FMS+V2+-+2025.06.2&amp;amp;utm_medium=ghl" vertex="1">
          <mxGeometry height="100" width="560" x="2390" y="1990" as="geometry" />
        </mxCell>
        <mxCell id="RDyThFTYfkmwOs9I9s8V-67" parent="1" style="text;whiteSpace=wrap;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;fontFamily=Courier New;" value="{&#xa;  &quot;rubric_name&quot;: &quot;Reduced Consulting Case Interview Rubric&quot;,&#xa;  &quot;score_scale&quot;: {&#xa;    &quot;1&quot;: &quot;Needs improvement&quot;,&#xa;    &quot;2&quot;: &quot;Developing&quot;,&#xa;    &quot;3&quot;: &quot;Average&quot;,&#xa;    &quot;4&quot;: &quot;Excellent&quot;,&#xa;    &quot;not_tested&quot;: &quot;Insufficient evidence in the transcript&quot;&#xa;  },&#xa;  &quot;dimensions&quot;: {&#xa;    &quot;problem_structuring&quot;: {&#xa;      &quot;description&quot;: &quot;Assesses whether the student breaks the business problem into a clear and logical framework.&quot;,&#xa;      &quot;criteria&quot;: {&#xa;        &quot;1&quot;: &quot;No clear framework or only an uncategorised list.&quot;,&#xa;        &quot;2&quot;: &quot;Some structure is present, but categories are weak, generic or not MECE.&quot;,&#xa;        &quot;3&quot;: &quot;Clear structure with relevant categories, but limited prioritisation or measurable detail.&quot;,&#xa;        &quot;4&quot;: &quot;Clear, MECE, case-specific and prioritised framework with relevant data points.&quot;&#xa;      }&#xa;    },&#xa;    &quot;business_logic&quot;: {&#xa;      &quot;description&quot;: &quot;Assesses whether the student connects their reasoning to the business objective of the case.&quot;,&#xa;      &quot;criteria&quot;: {&#xa;        &quot;1&quot;: &quot;Reasoning is disconnected from the business problem.&quot;,&#xa;        &quot;2&quot;: &quot;Shows partial understanding but often expands or complicates the problem unnecessarily.&quot;,&#xa;        &quot;3&quot;: &quot;Understands the problem and links some insights back to the main issue.&quot;,&#xa;        &quot;4&quot;: &quot;Maintains strong focus on the business objective and consistently drives toward a solution.&quot;&#xa;      }&#xa;    },&#xa;    &quot;assumptions_and_evidence&quot;: {&#xa;      &quot;description&quot;: &quot;Assesses whether the student justifies assumptions and supports claims with evidence from the case.&quot;,&#xa;      &quot;criteria&quot;: {&#xa;        &quot;1&quot;: &quot;Makes claims without justification or evidence.&quot;,&#xa;        &quot;2&quot;: &quot;Provides some assumptions but they are vague, unsupported or not clearly explained.&quot;,&#xa;        &quot;3&quot;: &quot;Uses relevant assumptions and evidence, but not consistently or deeply.&quot;,&#xa;        &quot;4&quot;: &quot;Clearly states, justifies and connects assumptions to case evidence and business implications.&quot;&#xa;      }&#xa;    },&#xa;    &quot;communication&quot;: {&#xa;      &quot;description&quot;: &quot;Assesses whether the student communicates clearly, concisely and in an interview-appropriate way.&quot;,&#xa;      &quot;criteria&quot;: {&#xa;        &quot;1&quot;: &quot;Unclear, hard to follow or lacks confidence.&quot;,&#xa;        &quot;2&quot;: &quot;Some clear points, but often rambling or unstructured.&quot;,&#xa;        &quot;3&quot;: &quot;Mostly clear and concise, but could improve prioritisation or synthesis.&quot;,&#xa;        &quot;4&quot;: &quot;Clear, confident, concise and structured communication using logical points.&quot;&#xa;      }&#xa;    }&#xa;  }&#xa;}" vertex="1">
          <mxGeometry height="707.5" width="920" x="3060" y="1686.25" as="geometry" />
        </mxCell>
        <mxCell id="kh5bWiEy8WdyAaxlAQ-b-2" parent="1" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#f8cecc;strokeColor=#b85450;" value="Student" vertex="1">
